generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  role          String    @default("USER") // Emulating Role enum: USER, ADMIN
  isVerified    Boolean   @default(false)
  otpCode       String?
  otpExpiresAt  DateTime?
  refreshToken  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  portfolio     Portfolio?
  orders        Order[]
  watchlists    Watchlist[]
  notifications Notification[]
}

model Portfolio {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance     Decimal  @default(100000.00) // Starting cash balance
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions   Position[]
  orders      Order[]
}

model Position {
  id           String    @id @default(uuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol       String
  quantity     Decimal
  averagePrice Decimal
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([portfolioId, symbol])
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioId    String
  portfolio      Portfolio   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol         String
  side           String      // BUY, SELL
  type           String      // MARKET, LIMIT
  status         String      @default("PENDING") // PENDING, EXECUTED, CANCELLED, FAILED
  quantity       Decimal
  limitPrice     Decimal?    
  executionPrice Decimal?    
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     WatchlistItem[]
}

model WatchlistItem {
  id          String    @id @default(uuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbol      String
  addedAt     DateTime  @default(now())

  @@unique([watchlistId, symbol])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String           // SYSTEM, ALERT, TRADE_EXECUTION
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}
